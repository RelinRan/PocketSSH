<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#4AD8FF" android:centerColor="#236FAF" android:endColor="#12375F" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#102B4B" android:endColor="#091A31" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>
