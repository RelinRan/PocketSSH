<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PocketSSH" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ssh_accent</item>
        <item name="colorPrimaryVariant">@color/ssh_surface</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/ssh_accent</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorAccent">@color/ssh_accent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/ssh_background</item>
        <item name="android:navigationBarColor">@color/ssh_background</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="Widget.PocketSSH.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:textColorHint">@color/ssh_hint_color</item>
        <item name="hintTextColor">@color/ssh_hint_color</item>
        <item name="boxStrokeColor">@color/ssh_field_stroke</item>
        <item name="boxBackgroundColor">@color/ssh_input_bg</item>
        <item name="colorControlNormal">@color/ssh_hint</item>
        <item name="colorControlActivated">@color/ssh_accent</item>
        <item name="colorOnSurface">@color/ssh_text</item>
        <item name="endIconTint">@color/ssh_input_icon_tint</item>
        <item name="errorTextColor">@color/ssh_error</item>
        <item name="helperTextTextColor">@color/ssh_hint</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>
</resources>
