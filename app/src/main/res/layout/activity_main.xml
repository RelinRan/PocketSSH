<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@drawable/bg_terminal_grid">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:gravity="center_horizontal" android:paddingStart="@dimen/page_horizontal_padding" android:paddingEnd="@dimen/page_horizontal_padding" android:paddingTop="30dp" android:paddingBottom="34dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:maxWidth="720dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="@color/ssh_text"
                        android:textSize="34sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_tagline"
                        android:textColor="@color/ssh_muted" android:textSize="11sp" android:fontFamily="monospace" android:layout_marginTop="3dp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ssh_version_label"
                    android:textColor="@color/ssh_accent" android:textSize="12sp" android:textStyle="bold" android:fontFamily="monospace" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:background="@drawable/bg_gradient_panel" android:padding="24dp" android:layout_marginTop="28dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/node_status_label"
                    android:textColor="@color/ssh_hint" android:textSize="12sp" android:textStyle="bold" android:fontFamily="monospace" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="8dp">
                    <TextView android:id="@+id/statusText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/state_offline" android:textColor="@color/ssh_offline" android:textSize="28sp" android:textStyle="bold" android:fontFamily="monospace" />
                    <TextView android:id="@+id/endpointText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/endpoint_unavailable" android:textColor="@color/ssh_accent" android:textSize="15sp" android:textStyle="bold" android:fontFamily="monospace" />
                </LinearLayout>
                <TextView android:id="@+id/errorText" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/ssh_error" android:textSize="12sp" android:visibility="gone" android:layout_marginTop="8dp" />
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/access_config_label"
                android:textColor="@color/ssh_hint" android:textSize="12sp" android:textStyle="bold" android:fontFamily="monospace" android:layout_marginTop="28dp" android:layout_marginBottom="12dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:background="@drawable/bg_status_panel" android:padding="22dp">
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/usernameLayout"
                    style="@style/Widget.RockchipSshSftp.TextInputLayout" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="@string/username_hint" android:textColorHint="@color/ssh_hint_color" app:hintTextColor="@color/ssh_hint_color">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/usernameInput" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="text" android:fontFamily="monospace" android:textColor="@color/ssh_text" android:textColorHint="@color/ssh_hint" android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/passwordLayout"
                    style="@style/Widget.RockchipSshSftp.TextInputLayout" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="@string/password_hint" app:endIconMode="password_toggle"
                    android:textColorHint="@color/ssh_hint_color" app:hintTextColor="@color/ssh_hint_color" app:endIconTint="@color/ssh_input_icon_tint" android:layout_marginTop="16dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/passwordInput" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="textPassword" android:fontFamily="monospace" android:textColor="@color/ssh_text" android:textColorHint="@color/ssh_hint" android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/portLayout"
                    style="@style/Widget.RockchipSshSftp.TextInputLayout" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="@string/port_hint" android:textColorHint="@color/ssh_hint_color" app:hintTextColor="@color/ssh_hint_color" android:layout_marginTop="16dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/portInput" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="number" android:fontFamily="monospace" android:textColor="@color/ssh_text" android:textColorHint="@color/ssh_hint" android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="20dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/powerButton" android:layout_width="0dp" android:layout_height="52dp"
                    android:layout_weight="1" android:text="@string/button_start_service" android:textColor="@color/ssh_text" android:textStyle="bold" android:background="@drawable/bg_gradient_outline_button"
                    app:backgroundTint="@null" android:letterSpacing="0" app:cornerRadius="10dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/saveButton" android:layout_width="0dp" android:layout_height="52dp"
                    android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/button_save_apply" android:textColor="@color/ssh_text"
                    android:textStyle="bold" android:background="@drawable/bg_gradient_button" app:backgroundTint="@null" android:letterSpacing="0" app:cornerRadius="10dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
